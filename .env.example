# IRIS-SIG-29 harvester configuration.
# Copy this file to .env and adjust values. Do not commit .env.

# Docker Compose / PostgreSQL
POSTGRES_DB=iris
POSTGRES_USER=iris
POSTGRES_PASSWORD=change-me

# Application
IRIS_DATABASE_URL=postgresql://iris:change-me@localhost:5432/iris
IRIS_REQUEST_DELAY_SECONDS=2.0
IRIS_HTTP_TIMEOUT_SECONDS=20
IRIS_HTTP_RETRIES=3
IRIS_USER_AGENT=iris-sig29-harvester/1.0
